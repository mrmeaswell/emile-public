# /etc/emile/emile.env — non-secret settings. The token lives in /etc/emile/token (0600).
EMILE_TRANSPORT=http
# 127.0.0.1 when cloudflared runs in this LXC; the LXC's LAN IP when cloudflared is elsewhere.
EMILE_HOST=127.0.0.1
EMILE_PORT=8765
# Public hostname(s) Cloudflare forwards as the Host header, comma-separated (DNS-rebinding allowlist).
EMILE_ALLOWED_HOSTS=emile.example.com
