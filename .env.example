# Emile local settings template. Copy to .env (gitignored) and fill in.
# Load with:  set -a; . ./.env; set +a
# Never commit a real .env or token.

# stdio (local MCP clients) or http (remote, token-gated)
EMILE_TRANSPORT=stdio
EMILE_HOST=127.0.0.1
EMILE_PORT=8765

# HTTP mode only: comma-separated public hostnames (DNS-rebinding allowlist)
EMILE_ALLOWED_HOSTS=emile.example.com

# HTTP mode only: set ONE of these. Token must be 32+ characters.
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Prefer EMILE_TOKEN_FILE (a 0600 file) over putting the token in the environment.
EMILE_TOKEN_FILE=/etc/emile/token
# EMILE_TOKEN=replace-with-a-32-plus-character-random-token

# install.sh only: LAN IP of the host running cloudflared, when it is not this machine
# EMILE_TUNNEL_IP=10.0.0.5
